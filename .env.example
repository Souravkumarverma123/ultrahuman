# ─── Database ────────────────────────────────────────────────────────────────
# Used by: packages/database
# Docker default (matches docker-compose.yml):
DATABASE_URL=postgresql://sourav:sourav345@localhost:5432/ultrahuman

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Used by: packages/auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_char_secret_here_replace_me
BETTER_AUTH_URL=http://localhost:8000

# ─── Google OAuth (used by Better Auth social login) ──────────────────────────
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Corsair ──────────────────────────────────────────────────────────────────
# Used by: packages/services/corsair
# Generate with: openssl rand -hex 32
CORSAIR_KEK=your_32_byte_hex_key_here

# ─── Corsair Google OAuth (for Gmail & Calendar integration) ─────────────────
# These are separate from Better Auth's Google OAuth — used by Corsair plugins
GOOGLE_REDIRECT_URI=http://localhost:8000/corsair/callback

# ─── OpenAI (AI Agent Chat) ───────────────────────────────────────────────────
# Used by: packages/trpc/server/routes/agent
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── API Server ───────────────────────────────────────────────────────────────
# Used by: apps/api
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# ─── Logger ───────────────────────────────────────────────────────────────────
# Used by: packages/logger
# Options: error | info | debug (defaults to debug in development)
# LOGGER_LEVEL=debug

# ─── Web App (Next.js) ────────────────────────────────────────────────────────
# Used by: apps/web
# Leave empty to use the Next.js proxy (/trpc) in development
# NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# ─── Webhooks (optional - for real-time Gmail/Calendar push) ─────────────────
# Run: ngrok http 8000 → copy the https URL here
# NGROK_URL=https://xxxx.ngrok.io

# ─── Resend (Email Verification Service) ──────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

