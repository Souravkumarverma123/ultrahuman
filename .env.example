# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# Used by: packages/database & docker-compose
# [Local Dev Default]

# [Production Docker Compose Defaults]
# These are used to spin up the Postgres container and build the connection string
POSTGRES_USER=testing
POSTGRES_PASSWORD=testing123
POSTGRES_DB=testing


# ─── BETTER AUTH ──────────────────────────────────────────────────────────────
# Used by: packages/auth & apps/web
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_char_better_auth_secret_replace_me

# [Local Dev]: http://localhost:8000
# [Production]: https://ultrahuman.co.in
BETTER_AUTH_URL=http://localhost:8000


# ─── GOOGLE OAUTH (Better Auth Social Login) ──────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# ─── CORSAIR INTEGRATIONS ─────────────────────────────────────────────────────
# Used by: packages/services/corsair
# Generate secret key with: openssl rand -hex 32
CORSAIR_KEK=your_32_byte_hex_key_here

# ─── CORSAIR GOOGLE OAUTH (Gmail & Calendar Integrations) ─────────────────────
# If different from Better Auth, specify these. Otherwise, they fallback to GOOGLE_CLIENT_ID/SECRET
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# [Local Dev]: http://localhost:8000/corsair/callback
# [Production]: https://ultrahuman.co.in/corsair/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/corsair/callback


# ─── OPENAI (AI Agent Integration) ────────────────────────────────────────────
# Used by: packages/trpc/server/routes/agent
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here


# ─── API SERVER CONFIGURATION ─────────────────────────────────────────────────
# Used by: apps/api
PORT=8000

# [Local Dev]: development
# [Production]: prod
NODE_ENV=development

# [Local Dev]: http://localhost:8000
# [Production]: https://ultrahuman.co.in
BASE_URL=http://localhost:8000

# [Local Dev]: http://localhost:3000
# [Production]: https://ultrahuman.co.in
WEB_URL=http://localhost:3000


# ─── WEB APP (Next.js) ────────────────────────────────────────────────────────
# Used by: apps/web
# [Local Dev]: Leave blank to use Next.js proxy
# [Production]: https://ultrahuman.co.in/trpc
NEXT_PUBLIC_API_URL=


# ─── DOMAIN & PROXY (Caddy Ingress) ───────────────────────────────────────────
# Used by: Caddyfile & docker-compose
# [Local Dev]: localhost
# [Production]: ultrahuman.co.in
DOMAIN_NAME=localhost


# ─── RESEND (Email Verification Service) ──────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here




# ─── DODO PAYMENTS GATEWAY ───────────────────────────────────────────────────
# Get from: https://dashboard.dodopayments.com/
DODO_PAYMENTS_API_KEY=dp_test_your_api_key_here
# Force environment mode: test_mode | live_mode (Optional, defaults to automatic detection based on API key or NODE_ENV)
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_key_here
DODO_PAYMENTS_MONTHLY_PRODUCT_ID=prod_subscription_monthly_here
DODO_PAYMENTS_ANNUAL_PRODUCT_ID=prod_subscription_annual_here

