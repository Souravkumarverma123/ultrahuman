# ─── Database ────────────────────────────────────────────────────────────────
# Used by: packages/database
# Docker default (matches docker-compose.yml):
DATABASE_URL=postgresql://sourav:sourav345@localhost:5432/ultrahuman

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Used by: packages/services
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/authentication/callback/google

# ─── API Server ───────────────────────────────────────────────────────────────
# Used by: apps/api
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000

# ─── Logger ───────────────────────────────────────────────────────────────────
# Used by: packages/logger
# Options: error | info | debug (defaults to debug in development)
# LOGGER_LEVEL=debug

# ─── Web App (Next.js) ────────────────────────────────────────────────────────
# Used by: apps/web
# Leave empty to use the Next.js proxy (/trpc) in development
# NEXT_PUBLIC_API_URL=http://localhost:8000/trpc
